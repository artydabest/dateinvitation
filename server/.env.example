# ──────────────────────────────────────────────────────────────
#  Server environment — copy to server/.env and fill in.
#  NOTHING here is required: with an empty .env the site works
#  fully (in-memory RSVPs, calendar link + .ics fallbacks,
#  emails printed to the console).
# ──────────────────────────────────────────────────────────────

# ── Basic ─────────────────────────────────────────────────────
PORT=4000
# Where the Vite client runs in dev (used for CORS + OAuth redirects)
CLIENT_URL=http://localhost:5173

# ── Google Calendar push (optional) ───────────────────────────
# Only needed for the automatic "add to Roshan's calendar" push.
# 1. console.cloud.google.com → new project
# 2. OAuth consent screen → External → Testing → add your Gmail as test user
# 3. Credentials → Create OAuth client ID → Web application
# 4. Authorized redirect URI: http://localhost:4000/api/google/callback
# 5. Paste the client ID/secret below, then visit
#    http://localhost:4000/api/google/auth ONCE to grant consent.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/google/callback
# Where the refresh token is stored (JSON file, gitignored).
GOOGLE_TOKEN_STORE_FILE=google-oauth-tokens.json

# ── Email (optional) ──────────────────────────────────────────
# console → prints emails to the server log (default, zero config)
# resend  → real delivery via resend.com (set RESEND_API_KEY)
EMAIL_PROVIDER=console
# From address. For Resend testing you can use their sandbox address:
EMAIL_FROM="Roshan's website <onboarding@resend.dev>"
RESEND_API_KEY=

# ── Database (optional) ───────────────────────────────────────
# Unset → in-memory store (data resets on restart — fine for the big day).
# Local:  mongodb://127.0.0.1:27017/sakshi-date
# Atlas:  mongodb+srv://<user>:<pass>@cluster.mongodb.net/sakshi-date
MONGODB_URI=
